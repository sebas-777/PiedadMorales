---
// Hero section for La Matria (Piedad Morales) - Stitch Design System
---

<section 
  id="hero" 
  class="relative overflow-hidden pt-8 pb-16 lg:py-20 px-6 sm:px-8 max-w-7xl mx-auto"
>
  <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    
    <!-- Left Column: Editorial & Narrative Content (7 cols on lg) -->
    <div class="lg:col-span-7 flex flex-col gap-6 relative z-10">
      
      <!-- Watermark Background Decorative Glyph -->
      <div 
        class="absolute -top-12 -left-8 text-ochre opacity-15 pointer-events-none select-none transform -rotate-12"
        aria-hidden="true"
      >
        <span class="material-symbols-outlined text-[130px] leading-none">gesture</span>
      </div>

      <!-- Archival Badge / Category Pill -->
      <div class="inline-flex items-center gap-2 self-start bg-secondary-fixed/60 text-on-secondary-fixed px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase border border-ochre/30 shadow-xs">
        <span class="material-symbols-outlined text-sm text-ochre">auto_awesome</span>
        <span>Archivo Vivo • Homenaje Poético</span>
      </div>

      <!-- Main Headline in Playfair Display -->
      <div class="space-y-1">
        <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-terracotta leading-[1.08] tracking-tight">
          La Matria
        </h1>
        <p class="font-display italic text-2xl sm:text-3xl text-ochre font-medium">
          El Hada Rebelde de la palabra
        </p>
      </div>

      <!-- Descriptive Narrative Body -->
      <p class="font-body text-base sm:text-lg text-on-surface-variant max-w-xl leading-relaxed">
        Tejido con memoria y poesía. Un espacio dedicado a <strong class="text-charcoal font-semibold">Piedad Morales</strong>, donde la palabra se vuelve hilo, la risa un acto político y la lucha comunitaria se viste de colores orgánicos y dignidad.
      </p>

      <!-- Poetic Excerpt Card in Courier Prime -->
      <div class="bg-paper-grain p-4 sm:p-5 rounded-md border border-outline-variant/60 relative paper-shadow max-w-lg colouring-fill">
        <div class="flex items-center gap-2 mb-2 text-terracotta text-xs font-mono uppercase tracking-wider font-bold">
          <span class="material-symbols-outlined text-sm">edit_note</span>
          <span>Fragmento • Des Hojada Palabra</span>
        </div>
        <blockquote class="font-poetry text-charcoal text-sm sm:text-base italic leading-relaxed pl-2 border-l-2 border-terracotta">
          «Como hilo rojo que zurce el tiempo, la memoria se niega a ser silencio. En cada puntada, un nombre. En cada verso, un hogar.»
        </blockquote>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a 
          href="#biografia" 
          class="bg-terracotta text-on-primary font-body font-bold text-sm uppercase tracking-wider px-6 py-3.5 rounded-xl hover:scale-105 active:scale-95 transition-all shadow-md rag-doll-border-alt inline-flex items-center gap-2 group"
        >
          <span>Descubrir su historia</span>
          <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">
            arrow_forward
          </span>
        </a>

        <a 
          href="#poesia" 
          class="bg-surface border-2 border-ochre/60 text-ochre font-body font-bold text-sm uppercase tracking-wider px-5 py-3 rounded-xl hover:bg-secondary-fixed/40 hover:scale-105 active:scale-95 transition-all inline-flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-lg">menu_book</span>
          <span>Leer Poesía</span>
        </a>
      </div>

      <!-- Archival Tags & Attributes -->
      <div class="flex flex-wrap items-center gap-2 pt-2 text-xs font-body text-on-surface-variant">
        <span class="font-semibold text-charcoal">Resonancias:</span>
        <span class="bg-surface-container px-2.5 py-1 rounded-full border border-outline-variant/40">Vamos Mujer</span>
        <span class="bg-surface-container px-2.5 py-1 rounded-full border border-outline-variant/40">Ruta Pacífica</span>
        <span class="bg-surface-container px-2.5 py-1 rounded-full border border-outline-variant/40">Carnavalenguas</span>
        <span class="bg-tertiary-fixed text-on-tertiary-fixed px-2.5 py-1 rounded-full font-medium">Lilas de Colombia</span>
      </div>

    </div>

    <!-- Right Column: Tactile Mixed-Media Artwork Frame (5 cols on lg) -->
    <div class="lg:col-span-5 relative flex justify-center items-center">
      
      <!-- Ambient Glow Blobs -->
      <div 
        class="absolute -inset-4 bg-secondary-container/40 rounded-full blur-3xl transform scale-110 -translate-y-4 pointer-events-none"
        aria-hidden="true"
      ></div>
      <div 
        class="absolute -inset-2 bg-tertiary-fixed/30 rounded-full blur-2xl transform translate-x-6 translate-y-6 pointer-events-none"
        aria-hidden="true"
      ></div>

      <!-- Main Illustrated Card with Rag-Doll Border & Tactile Slant -->
      <div class="relative w-full max-w-md">
        
        <!-- Cross-stitch detailing at Top Left -->
        <div class="absolute -top-3 -left-3 z-20 flex items-center gap-1 text-ochre select-none pointer-events-none" aria-hidden="true">
          <span class="material-symbols-outlined text-lg rotate-45">close</span>
          <span class="material-symbols-outlined text-lg rotate-45">close</span>
        </div>

        <!-- Frame Container -->
        <div class="rag-doll-border bg-surface-container-highest overflow-hidden paper-shadow p-2.5 sm:p-3 transform rotate-2 hover:rotate-0 transition-transform duration-500 group bg-paper-grain">
          
          <div class="relative overflow-hidden rounded-lg aspect-[4/5] bg-surface-container">
            <!-- Piedad Morales Hero Portrait -->
            <img 
              src="/images/piedad-hero.jpg" 
              alt="Ilustración artesanal de Piedad Morales en estilo muñeca de trapo, bordada con hilos cálidos de terracota y ocre" 
              class="w-full h-full object-cover object-center mix-blend-multiply opacity-95 group-hover:scale-105 transition-transform duration-700"
              loading="eager"
            />

            <!-- Subtle Inset Grain Vignette -->
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/40 via-transparent to-transparent pointer-events-none"></div>

            <!-- Overlaid Caption Badge inside Image -->
            <div class="absolute bottom-3 left-3 right-3 bg-surface/90 backdrop-blur-xs p-2.5 rounded-md border border-outline-variant/50 shadow-sm flex items-center justify-between">
              <div>
                <p class="font-display font-bold text-terracotta text-sm leading-tight">
                  Piedad Morales
                </p>
                <p class="font-body text-[11px] text-on-surface-variant">
                  Medellín (1940 - 2007)
                </p>
              </div>
              <span class="bg-primary-fixed text-on-primary-fixed text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider">
                El Hada
              </span>
            </div>
          </div>

        </div>

        <!-- Cross-stitch detailing at Bottom Right -->
        <div class="absolute -bottom-3 -right-3 z-20 flex items-center gap-1 text-ochre select-none pointer-events-none" aria-hidden="true">
          <span class="material-symbols-outlined text-lg rotate-45">close</span>
          <span class="material-symbols-outlined text-lg rotate-45">close</span>
        </div>

        <!-- Floating Tactile Stamp / Seal -->
        <div class="absolute -bottom-6 -left-4 z-30 bg-surface-container-lowest text-feminist-purple p-3 rounded-full paper-shadow border-2 border-feminist-purple/40 flex items-center gap-2 transform -rotate-6 hover:rotate-0 transition-transform duration-300">
          <span class="material-symbols-outlined text-2xl text-feminist-purple">history_edu</span>
          <div class="pr-1">
            <p class="text-[10px] font-mono uppercase font-bold tracking-wider text-charcoal">Resistencia</p>
            <p class="text-[9px] text-feminist-purple font-bold">Por la Vida y la Paz</p>
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- Organic Running Stitch Border separating sections -->
  <div class="stitch-line w-full mt-14 opacity-70"></div>
</section>
