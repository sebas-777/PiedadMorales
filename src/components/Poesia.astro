<!-- Client-side Script for Video Player and Accordion -->
<script>
  // Video Player Logic
  const video = document.getElementById('poesia-video-player') as HTMLVideoElement | null;
  const playOverlay = document.getElementById('video-play-overlay');
  const togglePlayBtn = document.getElementById('video-toggle-play');
  const playIcon = document.getElementById('play-icon');
  const toggleMuteBtn = document.getElementById('video-toggle-mute');
  const muteIcon = document.getElementById('mute-icon');
  const progressBar = document.getElementById('video-progress-bar');
  const progressContainer = document.getElementById('video-progress-container');
  const timeDisplay = document.getElementById('video-time-display');
  const fullscreenBtn = document.getElementById('video-toggle-fullscreen');

  function formatTime(seconds: number): string {
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  }

  function togglePlay() {
    if (!video) return;
    if (video.paused || video.ended) {
      video.play();
      if (playIcon) playIcon.textContent = 'pause';
      if (playOverlay) playOverlay.classList.add('opacity-0', 'pointer-events-none');
    } else {
      video.pause();
      if (playIcon) playIcon.textContent = 'play_arrow';
      if (playOverlay) playOverlay.classList.remove('opacity-0', 'pointer-events-none');
    }
  }

  if (video) {
    playOverlay?.addEventListener('click', togglePlay);
    togglePlayBtn?.addEventListener('click', togglePlay);
    video.addEventListener('click', togglePlay);

    video.addEventListener('timeupdate', () => {
      if (!video) return;
      const current = video.currentTime;
      const duration = video.duration || 0;
      if (progressBar && duration > 0) {
        const pct = (current / duration) * 100;
        progressBar.style.width = `${pct}%`;
      }
      if (timeDisplay) {
        timeDisplay.textContent = `${formatTime(current)} / ${formatTime(duration)}`;
      }
    });

    video.addEventListener('loadedmetadata', () => {
      if (timeDisplay && video) {
        timeDisplay.textContent = `00:00 / ${formatTime(video.duration || 0)}`;
      }
    });

    video.addEventListener('ended', () => {
      if (playIcon) playIcon.textContent = 'play_arrow';
      if (playOverlay) playOverlay.classList.remove('opacity-0', 'pointer-events-none');
    });

    toggleMuteBtn?.addEventListener('click', () => {
      if (!video) return;
      video.muted = !video.muted;
      if (muteIcon) {
        muteIcon.textContent = video.muted ? 'volume_off' : 'volume_up';
      }
    });

    progressContainer?.addEventListener('click', (e: MouseEvent) => {
      if (!video) return;
      const rect = progressContainer.getBoundingClientRect();
      const clickPos = (e.clientX - rect.left) / rect.width;
      video.currentTime = clickPos * (video.duration || 0);
    });

    fullscreenBtn?.addEventListener('click', () => {
      if (!video) return;
      if (!document.fullscreenElement) {
        video.requestFullscreen?.() || (video as any).webkitRequestFullscreen?.();
      } else {
        document.exitFullscreen?.();
      }
    });
  }

  // Accordion Logic
  const triggers = document.querySelectorAll('.accordion-trigger');
  triggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = btn.nextElementSibling as HTMLElement | null;
      const arrow = btn.querySelector('.accordion-arrow') as HTMLElement | null;
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        btn.setAttribute('aria-expanded', 'false');
        panel?.classList.add('hidden');
        if (arrow) arrow.style.transform = 'rotate(0deg)';
      } else {
        btn.setAttribute('aria-expanded', 'true');
        panel?.classList.remove('hidden');
        if (arrow) arrow.style.transform = 'rotate(180deg)';
      }
    });
  });

  // Open the first poem by default for immediate delight
  if (triggers.length > 0) {
    const firstTrigger = triggers[0] as HTMLButtonElement;
    const firstPanel = firstTrigger.nextElementSibling as HTMLElement | null;
    const firstArrow = firstTrigger.querySelector('.accordion-arrow') as HTMLElement | null;
    firstTrigger.setAttribute('aria-expanded', 'true');
    firstPanel?.classList.remove('hidden');
    if (firstArrow) firstArrow.style.transform = 'rotate(180deg)';
  }

  // Copy Poem to Clipboard with Toast Notification
  const copyButtons = document.querySelectorAll('.copy-poem-btn');
  const toast = document.getElementById('poem-toast');

  copyButtons.forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const textToCopy = btn.getAttribute('data-poem-text');
      if (textToCopy) {
        try {
          await navigator.clipboard.writeText(textToCopy);
          if (toast) {
            toast.classList.remove('translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
              toast.classList.add('translate-y-24', 'opacity-0');
              toast.classList.remove('translate-y-0', 'opacity-100');
            }, 2500);
          }
        } catch (err) {
          console.error('Error copying to clipboard', err);
        }
      }
    });
  });
</script>
